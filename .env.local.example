# ── Supabase (auth + database) ──────────────────────────────────
# Get these from: supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase database connection string (for pg Pool — server-side queries)
# In Supabase → Settings → Database → Connection string → Session pooler (port 6543)
SUPABASE_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ── Google OAuth (Supabase Auth provider) ───────────────────────
# Configure in: Supabase → Authentication → Providers → Google
# Then add these to your Railway env vars too for the Supabase dashboard callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Google Indexing API (free, 200 URLs/day) ──────────────────
# 1. Enable Indexing API in Google Cloud Console
# 2. Create a service account, download JSON key
# 3. Add service account email as owner in Google Search Console
# 4. Paste the full JSON key content here (single line, escaped)
GOOGLE_INDEXING_SA_KEY={"type":"service_account","project_id":"..."}

# ── Recommended ────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
NEXT_PUBLIC_GA_ID=G-XXXXXXXX
YOUTUBE_API_KEY=your-youtube-api-key
RESEND_API_KEY=re_xxxxxxxxxxxx
CRON_SECRET=generate-random-string

# ── Optional ───────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Base URL
NEXT_PUBLIC_URL=https://selah.fm
