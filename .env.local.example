# ── Critical (required for core functionality) ──────────────────
DATABASE_URL=postgresql://...
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://selah.fm

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe (stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Recommended (enhances features — platform runs without these) ─
# Google Analytics (analytics.google.com → Admin → Data Streams)
NEXT_PUBLIC_GA_ID=G-XXXXXXXX

# YouTube Data API v3 (console.cloud.google.com → APIs → YouTube Data API v3)
YOUTUBE_API_KEY=your-youtube-api-key

# SMTP email (resend.com free: 100/day, brevo.com free: 300/day)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxx
SMTP_FROM=noreply@selah.fm

# Cron secret (any random string — protects /api/cron)
CRON_SECRET=generate-random-string

# ── Optional (social proof + OAuth) ────────────────────────────
# Spotify Web API (developer.spotify.com → Dashboard → Create App)
# Uses client credentials — one set works for all artists. No per-artist auth needed.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# TikTok OAuth (developers.tiktok.com → Manage Apps)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Instagram OAuth (developers.facebook.com → Create App)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# YouTube OAuth (console.cloud.google.com → Credentials → OAuth 2.0 Client ID)
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# Facebook OAuth (developers.facebook.com)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Base URL
NEXT_PUBLIC_URL=https://selah.fm
