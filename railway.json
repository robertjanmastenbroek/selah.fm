{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "cron": [
      {
        "schedule": "0 2 * * *",
        "path": "/api/cron/outreach-pipeline?limit=10&audit=30&campaigns=30",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 14 * * *",
        "path": "/api/cron/outreach-pipeline?limit=10&audit=30&campaigns=30",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 18 * * *",
        "path": "/api/cron/outreach-followup",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 10 * * *",
        "path": "/api/cron/blog-publish",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      }
    ]
  },
  "services": {
    "postgres": {
      "image": "postgres:16",
      "volumes": {
        "pgdata": "/var/lib/postgresql/data"
      }
    }
  }
}
