{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "cron": [
      { "schedule": "0 * * * *", "path": "/api/cron/dispatcher", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } }
    ]
  },
  "services": {
    "postgres": {
      "image": "postgres:16",
      "volumes": { "pgdata": "/var/lib/postgresql/data" }
    }
  }
}
