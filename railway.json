{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  },
  "services": {
    "postgres": {
      "image": "postgres:16",
      "volumes": {
        "pgdata": "/var/lib/postgresql/data"
      }
    }
  }
}
