{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "cron": [
      { "schedule": "0 */3 * * *", "path": "/api/cron/outreach-pipeline?limit=50&audit=80&campaigns=30", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "30 */3 * * *", "path": "/api/cron/email-outreach", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "15 */6 * * *", "path": "/api/cron/creator-discovery", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "45 */6 * * *", "path": "/api/cron/creator-outreach", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "0 10 * * *", "path": "/api/cron/outreach-followup", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "0 22 * * *", "path": "/api/admin/outreach?action=reaudit_emails&limit=100", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "0 10 * * *", "path": "/api/cron/blog-publish", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "0 8 * * *", "path": "/api/cron/blog-pipeline", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "0 9 * * *", "path": "/api/cron/welcome-sequence", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } },
      { "schedule": "0 11 * * *", "path": "/api/cron/reengage", "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" } }
    ]
  },
  "services": {
    "postgres": {
      "image": "postgres:16",
      "volumes": { "pgdata": "/var/lib/postgresql/data" }
    }
  }
}
