{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "cron": [
      {
        "schedule": "0 0,3,6,9,12,15,18,21 * * *",
        "path": "/api/cron/outreach-pipeline?limit=50&audit=80&campaigns=30",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 3,9,15,21 * * *",
        "path": "/api/cron/email-outreach",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 5,11,17,23 * * *",
        "path": "/api/cron/creator-discovery",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 6,12,18,0 * * *",
        "path": "/api/cron/creator-outreach",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 10 * * *",
        "path": "/api/cron/outreach-followup",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 22 * * *",
        "path": "/api/admin/outreach?action=reaudit_emails&limit=100",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      },
      {
        "schedule": "0 10 * * *",
        "path": "/api/cron/blog-publish",
        "headers": { "X-Cron-Secret": "${{CRON_SECRET}}" }
      }
    ]
  },
  "services": {
    "postgres": {
      "image": "postgres:16",
      "volumes": {
        "pgdata": "/var/lib/postgresql/data"
      }
    }
  }
}