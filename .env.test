# ── Test Environment ───────────────────────────────────────────
# Used by Vitest unit tests and Playwright E2E tests.
# Copy to .env.local for local development.

# App
NEXT_PUBLIC_URL=http://localhost:3000
E2E_BASE_URL=http://localhost:3000

# Supabase (requires running local Supabase or using test project)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon-key

# Stripe test keys
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Vitest runs in jsdom — no DB connection needed for unit tests
# Integration tests should mock external services
